# ===== 楽天ウェブサービス（無料） https://webservice.rakuten.co.jp/ =====
RAKUTEN_APP_ID=
RAKUTEN_ACCESS_KEY=
# 楽天アフィリエイトID（例: 1a2b3c4d.5e6f7a8b.1a2b3c4d.5e6f7a8b）
RAKUTEN_AFFILIATE_ID=

# ===== 楽天ROOM =====
# あなたのROOMのURL（Xのプロフィールに貼る。投稿本文にはURLを入れない）
ROOM_URL=

# ===== X API（従量課金） https://developer.x.com/ =====
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# 画像付きで投稿するか（1=する / 0=しない）。画像ありの方が反応は良いが追加課金の可能性あり
X_ATTACH_IMAGE=1

# ===== Threads（任意。Meta開発者アプリの User Token Generator で発行した長期トークン） =====
THREADS_ACCESS_TOKEN=
# 省略可。空なら自動取得
THREADS_USER_ID=
# Threads投稿の末尾に貼るリンク（空なら ROOM_URL）。ブログに誘導するなら https://xxxx.github.io/ を入れる
THREADS_LINK_URL=

# ===== Claude API（任意。未設定ならテンプレート文で投稿） =====
ANTHROPIC_API_KEY=

# ===== スマホ通知（任意） https://ntfy.sh =====
# スマホの ntfy アプリで購読するトピック名。推測されにくい長い名前にする（例: rakumitsu-room-7f3k9q2x）
NTFY_TOPIC=

# ===== ブログ（GitHub Pages） =====
# 公開URL。GitHub Actions では自動で https://<ユーザー名>.github.io/<リポジトリ名>/ になるので空でよい
SITE_URL=
SITE_NAME=らくみつ｜楽天で見つけた良いもの
X_PROFILE_URL=https://x.com/rakumitsu__room

# ===== 運用設定 =====
# 1回の実行で投稿する件数
POSTS_PER_RUN=1
# 同じ商品を再投稿しない日数
NO_REPEAT_DAYS=30
# 商品価格の下限・上限（円）。安すぎる商品は報酬が数円なので除外
MIN_PRICE=1500
MAX_PRICE=20000
# レビュー条件
MIN_REVIEW_COUNT=50
MIN_REVIEW_AVERAGE=4.2
